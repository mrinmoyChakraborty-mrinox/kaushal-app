<?xml version="1.0" encoding="utf-8"?>
<!--
  Integrated Unity AR library manifest (copied from
  D:\My project\Builds\UnityLibraryExport\unityLibrary and reconciled for the
  KAUSHAL host app).

  Reconciled changes vs the raw export:
  - Removed the UnityPlayerActivity declaration (and its LAUNCHER intent
    filter). The host app embeds UnityPlayerForActivityOrService inside
    MainActivity; Unity must not own application navigation.
  - Removed tools:replace / android:label / android:icon / android:theme and
    android:allowBackup: those referenced @string/app_name and @mipmap/app_icon
    which only exist in the reference launcher project. The host app owns
    label / icon / theme / backup policy.
  - Kept the Unity runtime meta-data and the ARCore optional meta-data.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
  <uses-feature android:name="android.hardware.camera" android:required="true" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:glEsVersion="0x00030001" />
  <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen.multitouch.distinct" android:required="false" />

  <application
      android:appCategory="game"
      android:enableOnBackInvokedCallback="true"
      android:extractNativeLibs="true"
      android:hardwareAccelerated="true">

    <meta-data android:name="com.google.ar.core" android:value="optional" />
    <meta-data android:name="unity.splash-mode" android:value="0" />
    <meta-data android:name="unity.splash-enable" android:value="True" />
    <meta-data android:name="unity.requested-visible-insets" android:value="" />
    <meta-data android:name="unity.system-bars-behavior" android:value="ShowTransientBarsBySwipe" />
    <meta-data android:name="unity.render-outside-safearea" android:value="True" />
    <meta-data android:name="notch.config" android:value="portrait|landscape" />
    <meta-data android:name="unity.auto-report-fully-drawn" android:value="true" />
    <meta-data android:name="unity.strip-engine-code" android:value="true" />
    <meta-data android:name="unity.run-without-focus" android:value="false" />
    <meta-data android:name="unity.auto-set-game-state" android:value="true" />
    <meta-data android:name="unityplayer.SkipPermissionsDialog" android:value="true" />
  </application>
</manifest>